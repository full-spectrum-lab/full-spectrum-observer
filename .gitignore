# Build output
**/bin/
**/obj/
artifacts/*
!artifacts/.gitkeep

# Local runtime/data (NOTE: 'data/' also matches the source dir src/Observer.Store/Data
# on case-insensitive filesystems; the negation below re-includes that source tree so the
# embedded Init.sql schema migration stays version-controlled.)
data/
!src/Observer.Store/Data/
logs/
temp/
engine/runtime/*
!engine/runtime/README.md

# IDE/user state
.vs/
.idea/
.vscode/
*.user
*.suo

# Python
__pycache__/
*.py[cod]
.venv/
.dotnet/
.packages/
.runtime/

# Generated/published runtime: provisioned into the release package at publish time
# (scripts/provision-runtime-python.ps1). Never tracked; keeps worktree-clean after a build.
/runtime/

# Secrets and local overrides
*.secrets.json
.env
.env.*
!*.example
