{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fullspectrumprotocol.com/schemas/observer/scenario-pack/manifest/1.0.0",
  "title": "ScenarioPackManifestV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "pack_id",
    "version",
    "digest",
    "compatible_observer_versions",
    "compatible_engine_versions",
    "input_schema_ref",
    "subject_types",
    "knowledge_requirements",
    "policy_profile_refs",
    "expected_observation",
    "reason_code_namespace",
    "evidence_requirements",
    "human_review_template",
    "golden_cases",
    "value_metrics",
    "known_limitations"
  ],
  "properties": {
    "contract": {
      "const": "fs-observer/scenario-pack-manifest/1"
    },
    "pack_id": {
      "type": "string",
      "minLength": 3,
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "compatible_observer_versions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "compatible_engine_versions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "input_schema_ref": {
      "type": "string",
      "minLength": 1
    },
    "subject_types": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "knowledge_requirements": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "policy_profile_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "expected_observation": {
      "type": "string",
      "minLength": 1
    },
    "reason_code_namespace": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{1,31}$"
    },
    "evidence_requirements": {
      "type": "string",
      "minLength": 1
    },
    "human_review_template": {
      "type": "string",
      "minLength": 1
    },
    "golden_cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "input_ref", "expected_conclusion", "expected_reason_code"],
        "properties": {
          "case_id": { "type": "string", "minLength": 1 },
          "input_ref": { "type": "string", "minLength": 1 },
          "expected_conclusion": { "type": "string", "minLength": 1 },
          "expected_reason_code": { "type": "string", "minLength": 1 }
        }
      }
    },
    "value_metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["metric_id", "definition", "collection_point"],
        "properties": {
          "metric_id": { "type": "string", "minLength": 1 },
          "definition": { "type": "string", "minLength": 1 },
          "collection_point": { "type": "string", "minLength": 1 }
        }
      }
    },
    "known_limitations": {
      "type": "string",
      "minLength": 1
    }
  }
}
