{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fullspectrumprotocol.com/packs/synthetic-policy-conflict/1.0.0/input",
  "type": "object",
  "additionalProperties": false,
  "required": ["sample_id", "clauses"],
  "properties": {
    "sample_id": { "type": "string", "minLength": 1 },
    "clauses": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["clause_id", "version", "text"],
        "properties": {
          "clause_id": { "type": "string" },
          "version": { "type": "string" },
          "text": { "type": "string" }
        }
      }
    }
  }
}
