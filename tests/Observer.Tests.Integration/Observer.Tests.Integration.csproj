<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>FullSpectrum.Observer.Tests.Integration</AssemblyName>
    <RootNamespace>FullSpectrum.Observer.Tests.Integration</RootNamespace>
    <!-- Keep the existing custom console runner (Program.cs) as the sole entry point. Module 1
         integration tests (Host bootstrap -> store persistence -> recovery round-trip) use
         xUnit + FluentAssertions alongside it. -->
    <GenerateProgramFile>false</GenerateProgramFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Observer.Contracts/Observer.Contracts.csproj" />
    <ProjectReference Include="../../src/Observer.Application/Observer.Application.csproj" />
    <ProjectReference Include="../../src/Observer.Execution/Observer.Execution.csproj" />
    <ProjectReference Include="../../src/Observer.EngineFacade/Observer.EngineFacade.csproj" />
    <ProjectReference Include="../../src/Observer.Evidence/Observer.Evidence.csproj" />
    <!-- M3-FIX-05 E2E: the EngineVersionWorkspaceE2ETests exercise the REAL AnalysisWorkspace
         (Observer.Host.Web.Services), so the integration test project must reference the Web host.
         The Unit project already references it; adding it here keeps the E2E suite co-located. -->
    <ProjectReference Include="../../src/Observer.Host.Web/Observer.Host.Web.csproj" />
    <ProjectReference Include="../../src/Observer.Store/Observer.Store.csproj" />
    <ProjectReference Include="../../src/Observer.Recovery/Observer.Recovery.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <!-- M2-RUN-01 + M2-SEC-01 "Candidate A": use the patched SourceGear.sqlite3 runtime via
         Microsoft.Data.Sqlite.Core + SQLitePCLRaw.provider.e_sqlite3 (no vulnerable bundle). -->
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="8.0.10" />
    <PackageReference Include="SQLitePCLRaw.core" Version="2.1.6" />
    <PackageReference Include="SQLitePCLRaw.provider.e_sqlite3" Version="2.1.6" />
    <PackageReference Include="SourceGear.sqlite3" Version="3.53.3" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="FluentAssertions" Version="6.12.2" />
  </ItemGroup>
</Project>
