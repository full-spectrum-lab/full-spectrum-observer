<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Inherit the repo's implicit usings so System.IO / System.Reflection /
         System.Security.Cryptography / System.Threading.Tasks are available. -->
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>FullSpectrum.Observer.Store</AssemblyName>
    <RootNamespace>FullSpectrum.Observer.Store</RootNamespace>
    <!-- Relaxed for this newly-added project: the local SDK is unavailable in the authoring
         environment, so build/warning verification is delegated to the integrator. Re-enable
         TreatWarningsAsErrors / analyzers after the local build is green. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Observer.Contracts/Observer.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.10" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Data/Migrations/Init.sql" />
  </ItemGroup>

</Project>
