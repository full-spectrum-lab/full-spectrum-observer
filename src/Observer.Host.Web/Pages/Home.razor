@page "/"
@rendermode InteractiveServer
@inject SystemDiagnostics Diagnostics
@inject AuditViewer Audit

<PageTitle>首页 — Observer 控制台</PageTitle>

<h1>概览</h1>

@if (_loading)
{
    <p class="muted">正在加载…</p>
}
else if (_error is not null)
{
    <div class="error-state" role="alert">加载失败：@_error</div>
}
else
{
    <div class="card">
        <h2>审计链状态</h2>
        <div class="region observer">
            @{
                var auditState = SystemDiagnostics.AuditChainStateLabel(_chain);
            }
            @if (auditState == "完整")
            {
                <p><span class="badge known">完整</span> 共 @_chain.RecordCount 条记录</p>
                <p class="muted">审计链已通过连续哈希校验，记录连续且未被篡改。</p>
            }
            else if (auditState == "尚未建立")
            {
                <p><span class="badge warn">尚未建立</span> 当前共 0 条审计记录</p>
                <p class="muted">尚未产生可验证的审计链。</p>
            }
            else
            {
                <p><span class="badge hardgate">断裂</span> @(_chain?.BrokenAtAuditId ?? "未知")</p>
                <p class="muted">@(_chain?.Message)</p>
            }
        </div>
    </div>

    <div class="card">
        <h2>存储指标</h2>
        <table>
            <thead><tr><th>指标</th><th>数量</th></tr></thead>
            <tbody>
                <tr><td>主体</td><td>@_diag.SubjectCount</td></tr>
                <tr><td>知识源</td><td>@_diag.KnowledgeSourceCount</td></tr>
                <tr><td>分析任务</td><td>@_diag.AnalysisTaskCount</td></tr>
                <tr><td>审计记录</td><td>@_diag.AuditCount</td></tr>
                <tr><td>活动主体版本</td><td>@_diag.ActiveSubjectVersions</td></tr>
                <tr><td>活动知识版本</td><td>@_diag.ActiveKnowledgeVersions</td></tr>
            </tbody>
        </table>
    </div>

    <div class="card">
        <h2>快速入口</h2>
        <p>
            <a class="btn" href="subjects">主体管理</a>
            <a class="btn secondary" href="knowledge">知识库管理</a>
            <a class="btn secondary" href="new-analysis">新建分析</a>
            <a class="btn secondary" href="records">分析记录</a>
            <a class="btn secondary" href="audit">审计与证据</a>
            <a class="btn secondary" href="system">系统信息</a>
        </p>
        <p class="shortcut-hint">键盘：<span class="kbd">Tab</span> 在链接间移动，<span class="kbd">Enter</span> 进入。</p>
    </div>

    <div class="card">
        <h2>锚定引擎标识（v1.5.0 · ADR-003）</h2>
        <div class="region engine">
            <p>engine_tag = <code>@_ver.EngineTag</code></p>
            <p>engine_commit = <code>@_ver.EngineCommit</code></p>
            <p>engine_source_digest = <code>@_ver.EngineSourceDigest</code></p>
            <p>schema_version = <code>@_ver.SchemaVersion</code></p>
            <p>schema_digest = <code>@_ver.SchemaDigest</code></p>
            <p>adapter_version = <code>@_ver.AdapterVersion</code></p>
            <p>compat_matrix = <code>@_ver.CompatibilityMatrixId</code></p>
            <p>build_channel = <code>@_ver.BuildChannel</code></p>
        </div>
        <div class="region observer">
            <h3>Observer 运行身份</h3>
            <p>observer_version = <code>@ObsVal(_ver.ObserverVersion)</code></p>
            <p>observer_commit = <code>@ObsVal(_ver.ObserverCommit)</code></p>
            <p>observer_package_sha256 = <code>@ObsVal(_ver.ObserverPackageSha256)</code></p>
            <p>identity_source = <code>@_ver.IdentitySource</code></p>
            <p class="muted">以上字段来自运行时身份来源（包外身份文件 / 包内发布清单 / 开发工作树）的真实元数据，不硬编码；若实例非从冻结包启动，则如实显示 NOT_AVAILABLE。包内发布清单不包含包自身 SHA-256，避免自引用。</p>
        </div>
    </div>

    <div class="card">
        <h2>监听端点</h2>
        <div class="region observer">
            <p>Console 访问地址（启动参数）：<code>@_ver.RequestedEndpoint</code></p>
            <p>实际监听端点：</p>
            @if (_ver.ActualBoundEndpoints.Count == 0)
            {
                <p><code>NOT_AVAILABLE</code></p>
            }
            else
            {
                <ul>
                    @foreach (var ep in _ver.ActualBoundEndpoints)
                    {
                        <li><code>@ep</code></li>
                    }
                </ul>
            }
            <p class="muted">@Diagnostics.BuildListenerSecurityNote()</p>
        </div>
    </div>
}

<div class="sr-only" aria-live="polite">@_live</div>

@code {
    #nullable enable
    private bool _loading = true;
    private string? _error;
    private string _live = "";
    private StoreDiagnostics _diag = new();
    private AuditChainVerification _chain = new(true, 0, null, string.Empty);
    private VersionInfo _ver = new(
        string.Empty, string.Empty, string.Empty, string.Empty, string.Empty,
        string.Empty, string.Empty, string.Empty, string.Empty, string.Empty,
        string.Empty, Array.Empty<string>(), string.Empty, string.Empty, string.Empty, string.Empty);

    private static string ObsVal(string? v) => string.IsNullOrWhiteSpace(v) ? "NOT_AVAILABLE" : v!;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _diag = await Diagnostics.GetStoreDiagnosticsAsync();
            _chain = await Audit.VerifyAsync();
            _ver = Diagnostics.GetVersionInfo();
            _live = "概览已加载。";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }
}
